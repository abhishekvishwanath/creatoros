# Model Router (backend/app/agent_service/model_router/router.py). Two
# interchangeable providers - agent code never talks to a provider SDK
# directly, so switching is just editing these values. If ANTHROPIC_API_KEY
# is set it wins; otherwise GROQ_API_KEY is used; if neither is set, agents
# return structured stub output instead of failing.
#
# Anthropic (production). Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Groq (free, interim - good for validating agent prompts/JSON-parsing against
# a real model before paying for Claude). Get a free key at https://console.groq.com
GROQ_API_KEY=

# Per-provider model names per tier - never hard-coded in agent logic.
MODEL_STRATEGIC_ANTHROPIC=claude-opus-5
MODEL_STANDARD_ANTHROPIC=claude-sonnet-5
MODEL_FAST_ANTHROPIC=claude-haiku-4-5-20251001
MODEL_STRATEGIC_GROQ=openai/gpt-oss-120b
MODEL_STANDARD_GROQ=openai/gpt-oss-120b
MODEL_FAST_GROQ=openai/gpt-oss-20b

# Postgres connection string.
# Local dev (docker compose up -d db):
DATABASE_URL=postgresql+asyncpg://creatoros:creatoros@localhost:5544/creatoros
# Supabase (Project Settings -> Database -> Connection string -> "Session pooler" or direct,
# NOT the transaction pooler on port 6543 - asyncpg needs a session-mode connection):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

# Supabase project settings (Project Settings -> API). SUPABASE_URL is also
# what gates real auth on: app/api/deps.py::get_current_user_id requires a
# verified Supabase Bearer token once it's set, and only falls back to the
# X-Debug-User-Id dev/test header when it's blank. Access tokens are
# verified against the project's public JWKS (SUPABASE_URL + "/auth/v1/
# .well-known/jwks.json") - no secret needed for that, which is what new
# Supabase projects sign with (ES256/RS256) by default.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for older Supabase projects still on legacy HS256 signing
# (Project Settings -> API -> JWT Settings -> "JWT Secret"). Leave blank if
# your project uses the default asymmetric signing keys.
SUPABASE_JWT_SECRET=

# CORS
WEB_ORIGIN=http://localhost:3000

# Environment
ENVIRONMENT=development

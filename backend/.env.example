# Anthropic API key for the Agent Service (backend/app/agent_service).
# Get one at https://console.anthropic.com/settings/keys
# Until this is set, agents return structured stub output instead of live Claude calls.
ANTHROPIC_API_KEY=

# Model routing (see backend/app/agent_service/model_router/router.py).
# Names live in config, never hard-coded in agent logic.
MODEL_STRATEGIC=claude-opus-4-1
MODEL_STANDARD=claude-sonnet-4-5
MODEL_FAST=claude-haiku-4-5

# Postgres connection string.
# Local dev (docker compose up -d db):
DATABASE_URL=postgresql+asyncpg://creatoros:creatoros@localhost:5544/creatoros
# Supabase (Project Settings -> Database -> Connection string -> "Session pooler" or direct,
# NOT the transaction pooler on port 6543 - asyncpg needs a session-mode connection):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

# Supabase project settings (Project Settings -> API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS
WEB_ORIGIN=http://localhost:3000

# Environment
ENVIRONMENT=development

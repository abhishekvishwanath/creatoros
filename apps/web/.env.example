# FastAPI backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Project Settings -> API -> Project URL / anon public key).
# Leave both blank to run in dev-mode auth instead (a local placeholder
# identity stored in the browser, sent as X-Debug-User-Id) — useful for
# local development without a Supabase project. Set both to enable real
# sign-up/sign-in via Supabase Auth (see app/login). The backend also needs
# SUPABASE_JWT_SECRET set (backend/.env) to verify the resulting sessions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
